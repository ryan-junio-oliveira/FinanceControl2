# ============================================================
# Prumo — ambiente Docker de produção
# Copie para .env.docker na raiz e ajuste os segredos:
#   cp docker/.env.docker.example .env.docker
# Gere a APP_KEY localmente: php artisan key:generate --show
# ============================================================

APP_NAME=Prumo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------- Banco (MariaDB) ----------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=finfamilia
DB_USERNAME=finfam
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
# Porta publicada no host
DB_PORT_PUBLISHED=3306

# ---------- Sessão / Cache (Redis) ----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_PORT_PUBLISHED=6379

# ---------- Fila (RabbitMQ) ----------
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=finfam
RABBITMQ_PASSWORD=troque-esta-senha-rabbit
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

# Brapi (cotações B3 — opcional; sem token usa Yahoo Finance)
BRAPI_TOKEN=
RABBITMQ_AMQP_PORT_PUBLISHED=5672
RABBITMQ_MGMT_PORT_PUBLISHED=15672

# ---------- Portas publicadas ----------
NGINX_PORT=8080
PMA_PORT=8081

# ---------- E-mail (fila) ----------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contato@finfamilia.local"
MAIL_FROM_NAME="${APP_NAME}"
