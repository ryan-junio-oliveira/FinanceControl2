# Modelo de ambiente Docker/produção — copie para .env.docker e preencha os segredos:
#   cp .env.docker.example .env.docker
# Nunca commite o .env.docker (está no .gitignore).

APP_NAME=Prumo
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.seudominio.com.br
APP_KEY=
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---------- Banco MySQL (serviço `db`) ----------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=prumo
DB_USERNAME=prumo
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT_PUBLISHED=3306
# Ajustes finos do MySQL (opcional):
# MYSQL_INNODB_BUFFER_POOL_SIZE=512M
# MYSQL_MAX_CONNECTIONS=200
# MYSQL_BINLOG_EXPIRE=604800

# ---------- Sessão / cache / fila ----------
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=rabbitmq

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PORT_PUBLISHED=6379
# REDIS_MAXMEMORY=256mb

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=prumo
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_AMQP_PORT_PUBLISHED=5672
RABBITMQ_MGMT_PORT_PUBLISHED=15672

# ---------- Backup diário (03:00, volume `backup_data` em /backups) ----------
BACKUP_PATH=/backups
BACKUP_PREFIX=prumo-db
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Offsite S3/MinIO (opcional — exige disco `s3` em config/filesystems.php):
# BACKUP_S3_DISK=s3
# BACKUP_S3_PREFIX=db-backups/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=

# ---------- HTTP ----------
NGINX_PORT=8080
PMA_PORT=8081

# ---------- E-mail (produção: smtp com credenciais) ----------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contato@seudominio.com.br
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Bot Telegram ----------
BOT_DRIVER=null
BOT_TELEGRAM_TOKEN=
BOT_TELEGRAM_SECRET=
BOT_STATE_TTL=30

# ---------- Mercado (opcional) ----------
BRAPI_TOKEN=

# ---------- Assinatura (Mercado Pago) ----------
BILLING_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_BACK_URL=${APP_URL}/plans
MERCADOPAGO_WEBHOOK_SECRET=
PLAN_TRIAL_DAYS=14
PLAN_MENSAL_PRICE=1.00
PLAN_ANUAL_PRICE=10.00
BLACKLIST_IP=false
SUPPORT_EMAIL=contato@seudominio.com.br
TUNNEL_URL=
