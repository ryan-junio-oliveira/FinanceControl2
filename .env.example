APP_NAME=Prumo
APP_ENV=local
APP_KEY=
# NUNCA deixe true em produção (vaza stack traces e config).
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Em produção HTTPS: SESSION_SECURE_COOKIE=true (sem isso o cookie trafega em HTTP).
# SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutos até expirar um token de API (padrão: 1 ano).
# SANCTUM_EXPIRATION=525600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Para produção com Docker: QUEUE_CONNECTION=rabbitmq

CACHE_STORE=database
# CACHE_PREFIX=

# =========================
# Redis (sessão/cache em produção)
# =========================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================
# RabbitMQ (fila em produção)
# =========================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

# =========================
# Brapi (cotações B3 na página Mercado — opcional)
# Sem token, usa Yahoo Finance como fallback.
# =========================
BRAPI_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================
# E-mail
# Dev: use "log" (envia para storage/logs, sem SMTP). Produção: "smtp".
# O app cai automaticamente em "log" se smtp estiver sem credenciais.
# =========================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SEND_WELCOME_IN_LOCAL=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost:8000/auth/google/callback

BOT_DRIVER=null
BOT_TELEGRAM_TOKEN=
BOT_TELEGRAM_SECRET=
BOT_STATE_TTL=30

# =========================
# Comprovantes (OCR local)
# Usa o binário portátil em bin/tesseract (na raiz do projeto).
# Para usar um tesseract instalado, defina TESSERACT_BIN/TESSDATA_DIR.
# =========================
RECEIPT_READER=tesseract
TESSERACT_BIN=
TESSDATA_DIR=

VITE_APP_NAME="${APP_NAME}"

# =========================
# Assinatura (Mercado Pago)
# =========================
BILLING_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_BACK_URL=
PLAN_TRIAL_DAYS=14
PLAN_MENSAL_PRICE=1.00
PLAN_ANUAL_PRICE=10.00
MERCADOPAGO_WEBHOOK_SECRET=
BLACKLIST_IP=false
SUPPORT_EMAIL=contato@prumo.com.br

# URL pública fixa do túnel Cloudflare (ex.: https://app.seudominio.com.br)
TUNNEL_URL=
